<style>
.container { max-width: 1200px; margin: 0 auto; padding: 8rem 3rem 4rem; }

.section-divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 5rem 0;
}

.section-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--text-dim);
    margin-bottom: 1rem;
    display: block;
}

.section-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    font-weight: 400;
    margin-bottom: 1rem;
}

.section-sub {
    font-size: 1rem;
    color: var(--text-dim);
    line-height: 1.7;
    max-width: 600px;
    margin-bottom: 2rem;
}

.intro {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding: 6rem 3rem 5rem;
}
.intro .intro-content {
    position: relative;
    z-index: 3;
    max-width: 800px;
}
.intro h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    font-weight: 400;
    margin-bottom: 1.5rem;
}

.pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
}
.pillar {
    padding: 3rem 2rem;
    border-right: 1px solid var(--border);
    position: relative;
    transition: var(--transition);
}
.pillar:last-child { border-right: none; }
.pillar:hover { background: var(--surface); }
.pillar-num {
    font-size: 0.7rem;
    opacity: 0.35;
    margin-bottom: 2rem;
}
.pillar h2 {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 400;
    margin-bottom: 1rem;
    line-height: 1.2;
}
.pillar .pillar-desc {
    font-size: 0.8rem;
    color: var(--text-dim);
    line-height: 1.7;
    margin-bottom: 1.5rem;
}
.pillar ul {
    list-style: none;
    font-size: 0.75rem;
    color: var(--text-dim);
    line-height: 1.8;
}
.pillar ul li::before { content: '— '; opacity: 0.4; }

/* PORTFOLIO GALLERY */
.portfolio-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
}
.portfolio-item {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    cursor: pointer;
}
.portfolio-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}
.portfolio-item:hover img {
    transform: scale(1.08);
}
.portfolio-overlay {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 2rem;
    background: linear-gradient(transparent, rgba(61, 69, 77, 0.9));
    z-index: 2;
    transform: translateY(20px);
    opacity: 0;
    transition: var(--transition);
}
.portfolio-item:hover .portfolio-overlay {
    transform: translateY(0);
    opacity: 1;
}
.portfolio-overlay h4 {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    margin-bottom: 0.3rem;
}
.portfolio-overlay span {
    font-size: 0.7rem;
    opacity: 0.6;
}

/* VIDEO GRID */
.video-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    border: 1px solid var(--border);
}
.video-card {
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    transition: var(--transition);
}
.video-card:nth-child(2n) { border-right: none; }
.video-card:hover { background: var(--surface); }
.video-thumb {
    aspect-ratio: 16/9;
    overflow: hidden;
}
.video-thumb iframe {
    width: 100%;
    height: 100%;
    border: none;
}
.video-info {
    padding: 2rem;
}
.video-info h4 {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 400;
    margin-bottom: 0.5rem;
}
.video-info p {
    font-size: 0.8rem;
    color: var(--text-dim);
    line-height: 1.6;
}

/* STATS */
/* CTA */
.cta-block {
    text-align: left;
    padding: 5rem 3rem;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: var(--surface);
}
.cta-block h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 400;
    margin-bottom: 1rem;
    text-align: left;
}
.cta-block p {
    font-size: 0.9rem;
    color: var(--text-dim);
    margin: 0 0 2rem;
    line-height: 1.7;
}

.cta-block-grid {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 3rem;
    align-items: center;
}
.cta-block-gallery {
    min-width: 0;
    overflow: hidden;
}

.cta-block-scroll { overflow: hidden; }
.cta-block-track { display: flex; width: max-content; }
.cta-block-row-left .cta-block-track { animation: cta-block-scroll-left 60s linear infinite; }
.cta-block-row-right .cta-block-track { animation: cta-block-scroll-right 60s linear infinite; }
.cta-block-scroll:hover .cta-block-track { animation-play-state: paused; }
.cta-block-scroll img {
    width: 180px; height: 130px;
    object-fit: cover;
    border-radius: 4px;
    margin-right: 0.5rem;
    flex-shrink: 0;
}
@keyframes cta-block-scroll-left {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}
@keyframes cta-block-scroll-right {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
}
.btn-cta {
    background: var(--accent);
    color: var(--bg);
    border: none;
    padding: 1.2rem 2.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    cursor: pointer;
    transition: var(--transition);
    font-family: var(--font-sans);
    margin-top: 1rem;
}
.btn-cta:hover {
    background: transparent;
    color: var(--accent);
    outline: 1px solid var(--accent);
}

/* SLIDESHOW */
.slideshow {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 1;
}
.slideshow::after {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to right, rgba(61, 69, 77, 0.85) 0%, rgba(61, 69, 77, 0.55) 50%, rgba(61, 69, 77, 0.7) 100%);
    z-index: 2;
    pointer-events: none;
}
.slideshow-track {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1);
}
.slideshow-slide {
    min-width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
}
.slideshow-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.slideshow-controls {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    background: none;
    border: 1px solid rgba(233,228,223,0.2);
    color: var(--accent);
    width: 48px;
    height: 48px;
    cursor: pointer;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: var(--transition);
    opacity: 0;
}
.slideshow:hover .slideshow-controls { opacity: 1; }
.slideshow-controls:hover {
    background: rgba(233,228,223,0.1);
    border-color: rgba(233,228,223,0.45);
}
.slideshow-prev { left: 2rem; }
.slideshow-next { right: 2rem; }
.slideshow-dots {
    position: absolute;
    bottom: 2.5rem;
    right: 3rem;
    z-index: 4;
    display: flex;
    gap: 0.6rem;
    align-items: center;
}
.slideshow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid rgba(233,228,223,0.3);
    background: transparent;
    cursor: pointer;
    transition: var(--transition);
    padding: 0;
}
.slideshow-dot.active { background: var(--accent); border-color: var(--accent); }
.slideshow-counter {
    position: absolute;
    bottom: 2.5rem;
    left: 3rem;
    z-index: 4;
    font-size: 0.65rem;
    font-family: var(--font-sans);
    opacity: 0.4;
    letter-spacing: 0.2em;
}

@media (max-width: 1024px) {
    .portfolio-grid { grid-template-columns: 1fr 1fr; }
    .portfolio-item:nth-child(3n) { border-right: 1px solid var(--border); }
    .portfolio-item:nth-child(2n) { border-right: none; }
}

@media (max-width: 768px) {
    .container { padding: 6rem 1.5rem 3rem; }
    .pillars { grid-template-columns: 1fr; }
    .pillar { border-right: none; }
    .portfolio-grid { grid-template-columns: 1fr; }
    .portfolio-item:nth-child(2n) { border-right: 1px solid var(--border); }
    .portfolio-item:last-child { border-right: none; }
    .video-grid { grid-template-columns: 1fr; }
    .slideshow { aspect-ratio: auto; }
    .slideshow-caption { padding: 1.5rem; }
    .slideshow-caption h4 { font-size: 1.2rem; }
    .slideshow-controls { opacity: 1; width: 36px; height: 36px; }
    .slideshow-prev { left: 1rem; }
    .slideshow-next { right: 1rem; }
    .slideshow-dots { bottom: 1.5rem; right: 1.5rem; }
    .slideshow-counter { bottom: 1.5rem; left: 1.5rem; }
    .intro { min-height: 70vh; padding: 5rem 1.5rem 3rem; }
    .intro h1 { font-size: clamp(2rem, 7vw, 2.8rem); margin-bottom: 1rem; }
    .section-title { font-size: clamp(1.8rem, 5vw, 2.5rem); }
    .section-label { font-size: 0.6rem; }
    .section-sub { font-size: 0.85rem; }
    .pillar { padding: 2.5rem 1.5rem; }
    .pillar h2 { font-size: 1.5rem; }
    .cta-block { padding: 3rem 1.5rem; text-align: center; }
    .cta-block h2 { font-size: clamp(1.5rem, 4vw, 2rem); text-align: center; }
    .cta-block p { text-align: center; max-width: 480px; margin: 0 auto 2rem; }
    .cta-block-grid { grid-template-columns: 1fr; }
    .cta-block-gallery { order: 1; }
    .cta-block-text { order: 2; }
    .cta-block-scroll img { width: 140px; height: 100px; }
}
</style>

