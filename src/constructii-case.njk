.slideshow{position:absolute;inset:0;z-index:1;overflow:hidden}.slideshow:after{position:absolute;inset:0;z-index:2;background:linear-gradient(to right,rgba(61,69,77,.91),rgba(61,69,77,.55),rgba(61,69,77,.75));content:''}.slideshow-track{display:flex;width:100%;height:100%;transition:transform 1s cubic-bezier(.16,1,.3,1)}.slideshow-slide{min-width:100%;height:100%}.slideshow-slide img{width:100%;height:100%;object-fit:cover}.slideshow-controls{position:absolute;top:50%;z-index:4;width:48px;height:48px;transform:translateY(-50%);border:1px solid rgba(233,228,223,.25);background:none;color:var(--accent);cursor:pointer;opacity:0;transition:var(--transition)}.slideshow:hover .slideshow-controls{opacity:1}.slideshow-prev{left:2rem}.slideshow-next{right:2rem}.slideshow-dots{position:absolute;right:3rem;bottom:2.5rem;z-index:4;display:flex;gap:.6rem}.slideshow-dot{width:7px;height:7px;padding:0;border:1px solid rgba(233,228,223,.4);border-radius:50%;background:transparent;cursor:pointer}.slideshow-dot.active{background:var(--accent)}.slideshow-counter{position:absolute;bottom:2.5rem;left:3rem;z-index:4;font-size:.65rem;letter-spacing:.2em;opacity:.5}
.split{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;margin-top:3rem}.split-image{width:100%;max-width:480px;aspect-ratio:6/7;justify-self:end;overflow:hidden;border:1px solid var(--border)}.split-image img,.stage-media img{width:100%;height:100%;object-fit:cover;filter:grayscale(100%) brightness(.65);transition:var(--transition)}.split-image:hover img,.stage-card:hover .stage-media img{filter:grayscale(0) brightness(.95)}.list{display:grid;grid-template-columns:1fr 1fr;gap:0 2rem;margin:0;padding:0;list-style:none;color:var(--text-dim);font-size:.8rem;line-height:2}.list li:before,.stage-card li:before,.full-list li:before{content:'— ';opacity:.45}
.stage-grid{display:grid;grid-template-columns:repeat(2,1fr);margin-top:3rem;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.stage-card{border-right:1px solid var(--border);border-bottom:1px solid var(--border);transition:var(--transition)}.stage-card:nth-child(2n){border-right:0}.stage-card:nth-last-child(-n+2){border-bottom:0}.stage-card:hover{background:var(--surface)}.stage-media{height:220px;overflow:hidden;border-bottom:1px solid var(--border)}.stage-body{padding:2rem}.stage-num{margin-bottom:1rem;font-size:.7rem;opacity:.4}.stage-body h3{margin-bottom:.8rem;font-family:var(--font-serif);font-size:1.55rem;font-weight:400}.stage-body p,.stage-card li{color:var(--text-dim);font-size:.78rem;line-height:1.7}.stage-card ul{margin:1rem 0 0;padding:0;list-style:none}.stage-note{margin-top:1rem;color:var(--text-dim);font-size:.72rem;font-style:italic;line-height:1.6}
.banner{position:relative;display:flex;min-height:390px;align-items:center;justify-content:center;overflow:hidden;margin-top:5rem;border:1px solid var(--border);text-align:center}.banner img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(100%) brightness(.35)}.banner:after{position:absolute;inset:0;background:rgba(61,69,77,.45);content:''}.banner-content{position:relative;z-index:2;padding:3rem}.banner-quote{font-family:var(--font-serif);font-size:clamp(1.6rem,3.5vw,2.6rem);line-height:1.25}
