<script>
var currentSlide=0,totalSlides=document.querySelectorAll('.slideshow-slide').length,track=document.getElementById('slideshow-track'),dots=document.getElementById('slideshow-dots'),counter=document.getElementById('slideshow-counter'),autoPlay;for(var i=0;i<totalSlides;i++){var dot=document.createElement('button');dot.className='slideshow-dot'+(i===0?' active':'');dot.onclick=(function(n){return function(){goToSlide(n)}})(i);dots.appendChild(dot)}function goToSlide(n){currentSlide=n;track.style.transform='translateX(-'+n*100+'%)';document.querySelectorAll('.slideshow-dot').forEach(function(d,i){d.classList.toggle('active',i===n)});counter.textContent=(n+1)+' / '+totalSlides}function nextSlide(){goToSlide((currentSlide+1)%totalSlides);resetAutoPlay()}function prevSlide(){goToSlide((currentSlide-1+totalSlides)%totalSlides);resetAutoPlay()}function resetAutoPlay(){clearInterval(autoPlay);autoPlay=setInterval(function(){goToSlide((currentSlide+1)%totalSlides)},5000)}resetAutoPlay();function animateCounter(el,target){var start=performance.now();function tick(now){var p=Math.min((now-start)/1800,1);el.textContent=Math.round(target*(1-Math.pow(1-p,3))).toLocaleString('ro-RO');if(p<1)requestAnimationFrame(tick)}requestAnimationFrame(tick)}var observer=new IntersectionObserver(function(entries){if(entries[0].isIntersecting){animateCounter(document.getElementById('counter-projects'),178);animateCounter(document.getElementById('counter-clients'),143);animateCounter(document.getElementById('counter-years'),20);animateCounter(document.getElementById('counter-area'),32600);observer.disconnect()}},{threshold:.5});observer.observe(document.querySelector('.stats-row'));
</script>
