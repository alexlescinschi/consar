.flow{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:2.5rem}.flow-step{padding:.7rem 1rem;border:1px solid var(--border);color:var(--text-dim);font-size:.62rem;letter-spacing:.15em;text-transform:uppercase;transition:var(--transition)}.flow-step:hover{border-color:rgba(233,228,223,.4);background:var(--surface);color:var(--accent)}.flow-step b{margin-right:.5rem;opacity:.45}.service-list{display:grid;grid-template-columns:repeat(3,1fr);margin-top:3rem;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.service-item{padding:2.5rem 2rem;border-right:1px solid var(--border);border-bottom:1px solid var(--border);transition:var(--transition)}.service-item:nth-child(3n){border-right:0}.service-item:nth-last-child(-n+3){border-bottom:0}.service-item:hover{background:var(--surface)}.service-item h3{margin-bottom:.7rem;font-family:var(--font-serif);font-size:1.3rem;font-weight:400}.service-item p{color:var(--text-dim);font-size:.78rem;line-height:1.7}
.quote-box{padding:3rem;text-align:center;border:1px solid var(--border);background:var(--surface)}.quote-box strong{display:block;margin-bottom:1rem;font-family:var(--font-serif);font-size:clamp(1.4rem,3vw,2rem);font-weight:400}.quote-box p{max-width:560px;margin:0 auto;color:var(--text-dim);font-size:.85rem;line-height:1.7}.stats-row{display:grid;grid-template-columns:repeat(4,1fr);margin:5rem 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.stat-item{padding:3rem 2rem;border-right:1px solid var(--border);text-align:center}.stat-item:last-child{border-right:0}.stat-num{font-family:var(--font-serif);font-size:3rem}.stat-label{color:var(--text-dim);font-size:.65rem;letter-spacing:.2em;text-transform:uppercase}.cta-final{padding:5rem 3rem;border:1px solid var(--border);background:var(--surface);text-align:center}.cta-final h2{font-family:var(--font-serif);font-size:clamp(2rem,4vw,3rem);font-weight:400}.cta-final p{max-width:620px;margin:1rem auto 0;color:var(--text-dim);line-height:1.7}.cta-motto{margin:2rem 0;font-family:var(--font-serif);font-size:1.4rem}
@media(max-width:768px){.container{padding:6rem 1.5rem 3rem}.intro{min-height:70vh;padding:5rem 1.5rem 3rem}.slideshow-controls{width:36px;height:36px;opacity:1}.slideshow-prev{left:1rem}.slideshow-next{right:1rem}.slideshow-dots{right:1.5rem;bottom:1.5rem}.slideshow-counter{bottom:1.5rem;left:1.5rem}.split,.stage-grid,.service-list{grid-template-columns:1fr}.split-image{justify-self:stretch;max-width:none;aspect-ratio:16/10}.list{grid-template-columns:1fr}.stage-card,.service-item{border-right:0}.stage-card:nth-last-child(-n+2),.service-item:nth-last-child(-n+3){border-bottom:1px solid var(--border)}.stage-card:last-child,.service-item:last-child{border-bottom:0}.portfolio-grid{grid-template-columns:1fr}.stats-row{grid-template-columns:1fr 1fr}.stat-item{padding:2rem 1rem}.stat-item:nth-child(2){border-right:0}.stat-item:nth-child(-n+2){border-bottom:1px solid var(--border)}.cta-final{padding:3rem 1.5rem}}
</style>

<section class="intro"><div class="slideshow"><div class="slideshow-track" id="slideshow-track">{% for i in [1,2,3,4,5,6] %}<div class="slideshow-slide"><img src="/images/constructii-case/hero-0{{ i }}.jpg" alt="Construcții case {{ i }}" onerror="this.onerror=null;this.src='/images/constructii-case/ph/hero-0{{ i }}.svg';"></div>{% endfor %}</div><button class="slideshow-controls slideshow-prev" onclick="prevSlide()">&#8592;</button><button class="slideshow-controls slideshow-next" onclick="nextSlide()">&#8594;</button><div class="slideshow-dots" id="slideshow-dots"></div><div class="slideshow-counter" id="slideshow-counter">1 / 6</div></div><div class="intro-content"><span class="section-label">Construcții Case</span><h1>Construim casa ta<br>de la fundație<br>până la cheie.</h1><p class="section-sub" style="font-size:1.1rem">O echipă specializată, coordonare tehnică și atenție la fiecare etapă a lucrării.</p><p class="section-sub">De la fundație și structură până la acoperiș, fațadă și finisaje interioare, asigurăm execuția lucrărilor în funcție de proiect și de bugetul tău.</p><button class="btn-cta" onclick="openModal()">Solicită o Ofertă</button></div></section>

<div class="container">
<hr class="section-divider"><span class="section-label">Angajamentul Nostru</span><h2 class="section-title">Construim case.<br>Construim încredere.</h2><p class="section-sub">Construirea unei case este una dintre cele mai importante investiții pe care le faci.</p><div class="split"><div><ul class="list"><li>Execuție corectă</li><li>Respectarea proiectului</li><li>Organizarea lucrărilor</li><li>Controlul etapelor</li><li>Materiale corespunzătoare</li><li>Transparență privind costurile</li><li>Comunicare permanentă</li></ul><p class="section-sub" style="margin-top:2rem">Fiecare etapă este planificată astfel încât lucrările să avanseze organizat și eficient.</p></div><div class="split-image"><img src="/images/constructii-case/angajament.jpg" alt="Construcție casă" onerror="this.onerror=null;this.src='/images/constructii-case/ph/angajament.svg';"></div></div>

<hr class="section-divider"><span class="section-label">Stadii de Execuție</span><h2 class="section-title">Alegi unde începem.<br>Noi ducem casa mai departe.</h2><p class="section-sub">Poți contracta un stadiu precis sau construcția completă, până la predarea casei.</p>
{% set stadii=[
{t:'Case la roșu',d:'Executăm lucrările structurale necesare pentru realizarea construcției.',l:['Pregătirea terenului și fundații','Armare, cofrare și betonare','Zidărie, stâlpi și grinzi','Planșee, scări și structura acoperișului'],n:'Rezultatul: o construcție solidă, pregătită pentru următoarele etape.'},
{t:'Case la gri / semifinisate',d:'Continuăm după finalizarea structurii și aducem casa într-un stadiu avansat de execuție.',l:['Tencuieli și șape','Termoizolație și acoperiș','Tâmplărie și instalații','Fațadă și lucrări pregătitoare'],n:''},
{t:'Case la alb',d:'Pregătim casa pentru etapa finală de amenajare și personalizare.',l:['Glet și finisaje de bază','Instalații electrice și sanitare','Încălzire și termoizolație','Fațade și lucrări interioare'],n:''},
{t:'Case la cheie',d:'O singură echipă. Un singur proiect. O casă gata de locuit.',l:['Structură, acoperiș și fațadă','Instalații și încălzire','Finisaje, pardoseli și placări','Uși, obiecte sanitare și exterior'],n:'Stabilim exact ce este inclus în ofertă înainte de începerea lucrărilor.'}
] %}
<div class="stage-grid">{% for s in stadii %}<article class="stage-card"><div class="stage-media"><img src="/images/constructii-case/stadiu-0{{ loop.index }}.jpg" alt="{{ s.t }}" onerror="this.onerror=null;this.src='/images/constructii-case/ph/thumb-0{{ loop.index }}.svg';"></div><div class="stage-body"><div class="stage-num">[0{{ loop.index }}]</div><h3>{{ s.t }}</h3><p>{{ s.d }}</p><ul>{% for x in s.l %}<li>{{ x }}</li>{% endfor %}</ul>{% if s.n %}<p class="stage-note">{{ s.n }}</p>{% endif %}</div></article>{% endfor %}</div>
<div class="banner"><img src="/images/constructii-case/banner-cheie.jpg" alt="" onerror="this.onerror=null;this.src='/images/constructii-case/ph/banner-cheie.svg';"><div class="banner-content"><span class="section-label" style="color:var(--accent);opacity:.6">Construcție La Cheie</span><p class="banner-quote">„Tu vii cu proiectul.<br>Noi ne ocupăm de construcție."</p></div></div>

<hr class="section-divider"><span class="section-label">Portofoliu</span><h2 class="section-title">Case în lucru<br>și case finalizate</h2><p class="section-sub">Case și lucrări de execuție realizate de echipa noastră, în etape și în forma finală.</p>{% set serviciu_key = 'constructii-case' %}{% include "projects-strip.njk" %}

<hr class="section-divider"><span class="section-label">Lucrăm După Proiect</span><h2 class="section-title">Ai proiectul?<br>Noi îl construim.</h2><p class="section-sub">Analizăm documentația, estimăm cantitățile și costurile și stabilim împreună etapele de execuție. Ai doar o idee? Te ajutăm să pornești de la zero prin colaborare cu specialiști în arhitectură, structură, instalații, documentație tehnică și vizualizare 3D.</p><div class="flow"><span class="flow-step"><b>01</b>Analiză proiect</span><span class="flow-step"><b>02</b>Deviz și ofertă</span><span class="flow-step"><b>03</b>Organizare șantier</span><span class="flow-step"><b>04</b>Fundație</span><span class="flow-step"><b>05</b>Structură</span><span class="flow-step"><b>06</b>Închideri</span><span class="flow-step"><b>07</b>Instalații</span><span class="flow-step"><b>08</b>Finisaje</span><span class="flow-step"><b>09</b>Predare</span></div>

<hr class="section-divider"><span class="section-label">Servicii Complete</span><h2 class="section-title">Tot ce are nevoie<br>casa ta.</h2>{% set complete=[['Fundații și structură','Lucrări de fundație și structură conform proiectului tehnic.'],['Zidărie','Zidărie exterioară și interioară, cu respectarea dimensiunilor și detaliilor din proiect.'],['Acoperiș','Structură, învelitoare, termoizolație și accesorii adaptate soluției alese.'],['Termoizolații și fațade','Sisteme de termoizolație și finisaje exterioare adaptate proiectului.'],['Instalații','Electrice, sanitare, termice, încălzire în pardoseală și climatizare.'],['Finisaje interioare','Tencuire, gletuire, zugrăvire, placări, parchet, tavane și compartimentări.']] %}<div class="service-list">{% for c in complete %}<div class="service-item"><h3>{{ c[0] }}</h3><p>{{ c[1] }}</p></div>{% endfor %}</div>

<hr class="section-divider"><span class="section-label">Avantaje</span><h2 class="section-title">De ce să ne alegi?</h2>{% set avantaje=[['Un singur responsabil','Nu trebuie să cauți echipe pentru fiecare etapă. Coordonăm lucrările și subcontractorii implicați.'],['Deviz înainte de începere','Stabilim lucrările, cantitățile, materialele și costurile înainte de semnarea contractului.'],['Lucrăm pe baza proiectului','Execuția urmează documentația tehnică și soluțiile aprobate.'],['Controlul etapelor','Construcția este împărțită în etape clare, ușor de urmărit.'],['Comunicare directă','Ești informat despre progres și despre situațiile care pot influența costul sau termenul.']] %}<div class="service-list">{% for a in avantaje %}<div class="service-item"><h3>{{ a[0] }}</h3><p>{{ a[1] }}</p></div>{% endfor %}</div>

<hr class="section-divider"><span class="section-label">Buget</span><h2 class="section-title">Cât costă construirea<br>unei case?</h2><p class="section-sub">Prețul depinde de proiect și de nivelul de finisare dorit.</p><ul class="list"><li>Suprafață și regim de înălțime</li><li>Tipul fundației</li><li>Sistemul structural</li><li>Materialele utilizate</li><li>Complexitatea acoperișului</li><li>Nivelul de finisare</li><li>Instalațiile alese</li><li>Amplasarea construcției</li><li>Lucrările exterioare</li></ul><div class="quote-box" style="margin-top:3rem"><strong>Nu toate casele au același preț pe m².</strong><p>Îți pregătim o estimare în funcție de proiectul tău și de stadiul dorit: la roșu, la gri, la alb sau la cheie.</p><button class="btn-cta" onclick="openModal()">Cere Oferta</button></div>

<div class="stats-row"><div class="stat-item"><div class="stat-num" id="counter-projects">0</div><div class="stat-label">Proiecte Finalizate</div></div><div class="stat-item"><div class="stat-num" id="counter-clients">0</div><div class="stat-label">Clienți</div></div><div class="stat-item"><div class="stat-num" id="counter-years">0</div><div class="stat-label">Ani Experiență</div></div><div class="stat-item"><div class="stat-num" id="counter-area">0</div><div class="stat-label">m² Construiți</div></div></div>
<hr class="section-divider"><div class="cta-final"><h2>Ai terenul. Ai proiectul.<br>Acum hai să construim.</h2><p>Indiferent dacă vrei o casă compactă pentru familie sau o vilă modernă, analizăm proiectul și pregătim oferta pentru execuție.</p><div class="cta-motto">Construim. Coordonăm. Predăm.</div><button class="btn-cta" onclick="openModal()">Trimite Proiectul</button></div>
</div>

