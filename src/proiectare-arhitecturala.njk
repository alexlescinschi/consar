<style>
.container{max-width:1200px;margin:auto;padding:8rem 3rem 4rem}.section-divider{border:0;border-top:1px solid var(--border);margin:5rem 0}.section-label{display:block;margin-bottom:1rem;color:var(--text-dim);font-size:.65rem;letter-spacing:.3em;text-transform:uppercase}.section-title{margin-bottom:1rem;font-family:var(--font-serif);font-size:clamp(2rem,5vw,3.5rem);font-weight:400;line-height:1.1}.section-sub{max-width:650px;margin-bottom:2rem;color:var(--text-dim);font-size:1rem;line-height:1.7}.intro{position:relative;display:flex;min-height:100vh;flex-direction:column;justify-content:center;overflow:hidden;padding:6rem 3rem 5rem}.intro-content{position:relative;z-index:3;max-width:820px}.intro h1{margin-bottom:1.5rem;font-family:var(--font-serif);font-size:clamp(2.5rem,6vw,4.5rem);font-weight:400;line-height:1.05}.btn-cta{margin-top:1rem;padding:1.2rem 2.5rem;border:0;background:var(--accent);color:var(--bg);font-family:var(--font-sans);font-size:.75rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;cursor:pointer;transition:var(--transition)}.btn-cta:hover{outline:1px solid var(--accent);background:transparent;color:var(--accent)}
.slideshow{position:absolute;inset:0;z-index:1;overflow:hidden}.slideshow:after{position:absolute;inset:0;z-index:2;background:linear-gradient(to right,rgba(61,69,77,.92),rgba(61,69,77,.56),rgba(61,69,77,.78));content:''}.slideshow-track{display:flex;width:100%;height:100%;transition:transform 1s cubic-bezier(.16,1,.3,1)}.slideshow-slide{min-width:100%;height:100%}.slideshow-slide img{width:100%;height:100%;object-fit:cover}.slideshow-controls{position:absolute;top:50%;z-index:4;width:48px;height:48px;transform:translateY(-50%);border:1px solid rgba(233,228,223,.25);background:none;color:var(--accent);cursor:pointer;opacity:0;transition:var(--transition)}.slideshow:hover .slideshow-controls{opacity:1}.slideshow-prev{left:2rem}.slideshow-next{right:2rem}.slideshow-dots{position:absolute;right:3rem;bottom:2.5rem;z-index:4;display:flex;gap:.6rem}.slideshow-dot{width:7px;height:7px;padding:0;border:1px solid rgba(233,228,223,.4);border-radius:50%;background:transparent;cursor:pointer}.slideshow-dot.active{background:var(--accent)}.slideshow-counter{position:absolute;bottom:2.5rem;left:3rem;z-index:4;font-size:.65rem;letter-spacing:.2em;opacity:.5}
.split{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;margin-top:3rem}.split-image{width:100%;max-width:480px;aspect-ratio:6/7;justify-self:end;overflow:hidden;border:1px solid var(--border)}.split-image img,.media img{width:100%;height:100%;object-fit:cover;filter:grayscale(100%) brightness(.65);transition:var(--transition)}.split-image:hover img,.card:hover .media img{filter:grayscale(0) brightness(.95)}.list{display:grid;grid-template-columns:1fr 1fr;gap:0 2rem;margin:0;padding:0;list-style:none;color:var(--text-dim);font-size:.8rem;line-height:2}.list li:before,.card li:before{content:'— ';opacity:.45}
.card-grid{display:grid;grid-template-columns:repeat(2,1fr);margin-top:3rem;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.card{border-right:1px solid var(--border);border-bottom:1px solid var(--border);transition:var(--transition)}.card:nth-child(2n){border-right:0}.card:nth-last-child(-n+2){border-bottom:0}.card:hover{background:var(--surface)}.media{height:210px;overflow:hidden;border-bottom:1px solid var(--border)}.body{padding:2rem}.number{margin-bottom:1rem;font-size:.7rem;opacity:.4}.body h3{margin-bottom:.8rem;font-family:var(--font-serif);font-size:1.45rem;font-weight:400}.body p,.card li{color:var(--text-dim);font-size:.78rem;line-height:1.7}.card ul{margin:1rem 0 0;padding:0;list-style:none}.note{margin-top:1rem;color:var(--text-dim);font-size:.72rem;font-style:italic;line-height:1.6}
.banner{position:relative;display:flex;min-height:390px;align-items:center;justify-content:center;overflow:hidden;margin-top:5rem;border:1px solid var(--border);text-align:center}.banner img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(100%) brightness(.35)}.banner:after{position:absolute;inset:0;background:rgba(61,69,77,.45);content:''}.banner-content{position:relative;z-index:2;padding:3rem}.banner-quote{font-family:var(--font-serif);font-size:clamp(1.6rem,3.5vw,2.6rem);line-height:1.25}
.portfolio{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:3rem;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.portfolio-item{position:relative;aspect-ratio:4/3;overflow:hidden}.portfolio-item img{width:100%;height:100%;object-fit:cover;filter:grayscale(100%) brightness(.5);transition:var(--transition)}.portfolio-item:hover img{filter:grayscale(0) brightness(.9);transform:scale(1.06)}.overlay{position:absolute;right:0;bottom:0;left:0;padding:2rem;background:linear-gradient(transparent,rgba(61,69,77,.95));opacity:0;transform:translateY(15px);transition:var(--transition)}.portfolio-item:hover .overlay{opacity:1;transform:none}.overlay h4{margin-bottom:.3rem;font-family:var(--font-serif);font-size:1.2rem;font-weight:400}.overlay span{font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;opacity:.65}
.pills{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:2.5rem}.pill{padding:.7rem 1rem;border:1px solid var(--border);color:var(--text-dim);font-size:.62rem;letter-spacing:.15em;text-transform:uppercase;transition:var(--transition)}.pill:hover{border-color:rgba(233,228,223,.4);background:var(--surface);color:var(--accent)}.pill b{margin-right:.5rem;opacity:.45}.steps{display:grid;grid-template-columns:repeat(5,1fr);margin-top:3rem;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.step{padding:2.5rem 1.5rem;border-right:1px solid var(--border);transition:var(--transition)}.step:last-child{border-right:0}.step:hover{background:var(--surface)}.step-num{margin-bottom:1.3rem;font-size:.7rem;opacity:.4}.step h3{margin-bottom:.7rem;font-family:var(--font-serif);font-size:1.15rem;font-weight:400}.step p{color:var(--text-dim);font-size:.75rem;line-height:1.65}.pillars{display:grid;grid-template-columns:repeat(3,1fr);margin-top:3rem;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.pillar{padding:2.5rem 2rem;border-right:1px solid var(--border);border-bottom:1px solid var(--border);transition:var(--transition)}.pillar:nth-child(3n){border-right:0}.pillar:nth-last-child(-n+3){border-bottom:0}.pillar:hover{background:var(--surface)}.pillar h3{margin-bottom:.7rem;font-family:var(--font-serif);font-size:1.3rem;font-weight:400}.pillar p{color:var(--text-dim);font-size:.78rem;line-height:1.7}.quote{padding:3rem;border:1px solid var(--border);background:var(--surface);text-align:center}.quote strong{display:block;margin-bottom:1rem;font-family:var(--font-serif);font-size:clamp(1.4rem,3vw,2rem);font-weight:400}.quote p{max-width:560px;margin:auto;color:var(--text-dim);font-size:.85rem;line-height:1.7}.cta{padding:5rem 3rem;border:1px solid var(--border);background:var(--surface);text-align:center}.cta h2{font-family:var(--font-serif);font-size:clamp(2rem,4vw,3rem);font-weight:400}.cta p{max-width:600px;margin:1rem auto;color:var(--text-dim);line-height:1.7}.motto{margin:2rem 0;font-family:var(--font-serif);font-size:1.4rem}
@media(max-width:768px){.container{padding:6rem 1.5rem 3rem}.intro{min-height:70vh;padding:5rem 1.5rem 3rem}.slideshow-controls{width:36px;height:36px;opacity:1}.slideshow-prev{left:1rem}.slideshow-next{right:1rem}.slideshow-dots{right:1.5rem;bottom:1.5rem}.slideshow-counter{bottom:1.5rem;left:1.5rem}.split,.card-grid,.pillars,.portfolio{grid-template-columns:1fr}.split-image{justify-self:stretch;max-width:none;aspect-ratio:16/10}.list{grid-template-columns:1fr}.card,.pillar{border-right:0}.card:nth-last-child(-n+2),.pillar:nth-last-child(-n+3){border-bottom:1px solid var(--border)}.card:last-child,.pillar:last-child{border-bottom:0}.steps{grid-template-columns:1fr}.step{border-right:0;border-bottom:1px solid var(--border)}.step:last-child{border-bottom:0}.cta{padding:3rem 1.5rem}}
</style>

<section class="intro"><div class="slideshow"><div class="slideshow-track" id="slideshow-track">{% for i in [1,2,3,4,5,6] %}<div class="slideshow-slide"><img src="/images/proiectare-arhitecturala/hero-0{{ i }}.jpg" alt="Proiectare arhitecturală {{ i }}" onerror="this.onerror=null;this.src='/images/proiectare-arhitecturala/ph/hero-0{{ i }}.svg';"></div>{% endfor %}</div><button class="slideshow-controls slideshow-prev" onclick="prevSlide()">&#8592;</button><button class="slideshow-controls slideshow-next" onclick="nextSlide()">&#8594;</button><div class="slideshow-dots" id="slideshow-dots"></div><div class="slideshow-counter" id="slideshow-counter">1 / 6</div></div><div class="intro-content"><span class="section-label">Servicii de Proiectare Arhitecturală</span><h1>Proiectăm spații<br>care funcționează.</h1><p class="section-sub" style="font-size:1.1rem">Construim idei care prind contur.</p><p class="section-sub">De la prima schiță până la documentația tehnică și vizualizarea 3D, combinăm arhitectura, desenul tehnic, BIM și randările pentru a transforma ideea într-un proiect clar și funcțional.</p><button class="btn-cta" onclick="openModal()">Solicită o Ofertă</button></div></section>
<div class="container"><hr class="section-divider"><span class="section-label">Proiectare Completă</span><h2 class="section-title">De la idee<br>la proiect pregătit.</h2><p class="section-sub">Fiecare proiect începe cu înțelegerea nevoilor beneficiarului, a terenului și a obiectivelor construcției.</p><div class="split"><div><ul class="list"><li>Funcționalitate</li><li>Estetică</li><li>Eficiență</li><li>Optimizarea spațiului</li><li>Cerințe tehnice</li><li>Documentație pentru etapele următoare</li></ul><p class="section-sub" style="margin-top:2rem">Construiești o casă nouă, extinzi o clădire sau transformi un spațiu existent? Te ajutăm de la concept până la documentația tehnică.</p></div><div class="split-image"><img src="/images/proiectare-arhitecturala/concept.jpg" alt="Concept arhitectural" onerror="this.onerror=null;this.src='/images/proiectare-arhitecturala/ph/concept.svg';"></div></div>
<hr class="section-divider"><span class="section-label">Serviciile Noastre</span><h2 class="section-title">Un proiect clar.<br>Fiecare etapă acoperită.</h2>{% set servicii=[['Proiectare case și vile','Locuințe individuale adaptate stilului de viață, bugetului și terenului.',['Case parter, P+1 și P+M','Vile, case moderne sau clasice','Acoperiș terasă sau în ape','Locuințe personalizate']],['Construcții noi','Proiectare pentru rezidențial, comercial și alte tipuri de clădiri.',['Analiza temei și terenului','Concept, planuri, fațade, secțiuni','Planșe și documentație tehnică','Coordonare cu specialitățile']],['Renovări și extinderi','Soluții pentru construcții existente care trebuie modernizate.',['Renovări și recompartimentări','Extinderi și mansardări','Fațade și supraetajări','Reconversii funcționale']],['Desen tehnic și CAD','Documentație clară pentru arhitecți, ingineri, dezvoltatori și constructori.',['Planuri 2D, fațade și secțiuni','Detalii și planuri de execuție','Conversii și redesenări CAD','Schițe transformate în documentație']],['Modelare BIM și Revit','Un proiect digital, coordonat într-un mediu 3D inteligent.',['Coordonare și reducerea erorilor','Planuri și secțiuni din model','Documentație tehnică','Colaborare cu birouri de proiectare']],['Vizualizare arhitecturală 3D','Vezi proiectul înainte să începi construcția.',['Randări exterioare și interioare','Imagini fotorealiste','Modele 3D și prezentări','Vizualizări pentru dezvoltatori']],['Proiectare interioară','Soluții de amenajare frumoase, practice și coerente.',['Concept și compartimentare','Mobilier, finisaje și iluminat','Tavane și randări 3D','Documentație pentru execuție']],['Suport B2B pentru proiectare','Partener extern pentru companii care au nevoie de capacitate suplimentară.',['CAD, BIM și planșe arhitecturale','Detalii și randări 3D','Redesenarea proiectelor existente','Suport pentru proiecte în execuție']]] %}<div class="card-grid">{% for s in servicii %}<article class="card"><div class="media"><img src="/images/proiectare-arhitecturala/serv-0{{ loop.index }}.jpg" alt="{{ s[0] }}" onerror="this.onerror=null;this.src='/images/proiectare-arhitecturala/ph/thumb-0{{ loop.index }}.svg';"></div><div class="body"><div class="number">[0{{ loop.index }}]</div><h3>{{ s[0] }}</h3><p>{{ s[1] }}</p><ul>{% for x in s[2] %}<li>{{ x }}</li>{% endfor %}</ul></div></article>{% endfor %}</div>
<div class="banner"><img src="/images/proiectare-arhitecturala/banner.jpg" alt="" onerror="this.onerror=null;this.src='/images/proiectare-arhitecturala/ph/banner.svg';"><div class="banner-content"><span class="section-label" style="color:var(--accent);opacity:.6">Proiectare Digitală</span><p class="banner-quote">„Aveți o idee?<br>Noi o transformăm într-un proiect."</p></div></div>
<hr class="section-divider"><span class="section-label">Portofoliu</span><h2 class="section-title">Proiecte care<br>prind contur.</h2><p class="section-sub">O selecție de proiecte proiectate și documentate complet de echipa noastră.</p>{% set serviciu_key = 'proiectare-arhitecturala' %}{% include "projects-strip.njk" %}
<hr class="section-divider"><span class="section-label">Flux de Proiectare</span><h2 class="section-title">Proiectul se construiește<br>mai întâi pe hârtie.</h2><p class="section-sub">De la informațiile inițiale la documentația pregătită pentru următoarea etapă.</p><div class="pills"><span class="pill"><b>01</b>Discuție</span><span class="pill"><b>02</b>Analiză teren</span><span class="pill"><b>03</b>Concept</span><span class="pill"><b>04</b>Planuri</span><span class="pill"><b>05</b>Model BIM</span><span class="pill"><b>06</b>Randări</span><span class="pill"><b>07</b>Documentație</span></div>
<hr class="section-divider"><span class="section-label">Proces</span><h2 class="section-title">Cum lucrăm</h2><div class="steps"><div class="step"><div class="step-num">[01]</div><h3>Discutăm proiectul</h3><p>Ne transmiți informațiile despre teren, construcție și obiectiv.</p></div><div class="step"><div class="step-num">[02]</div><h3>Stabilim soluția</h3><p>Analizăm cerințele și propunem soluția adaptată.</p></div><div class="step"><div class="step-num">[03]</div><h3>Dezvoltăm proiectul</h3><p>Realizăm planurile, modelarea 3D și documentația.</p></div><div class="step"><div class="step-num">[04]</div><h3>Prezentăm proiectul</h3><p>Vezi construcția înainte de execuție prin randări, când sunt necesare.</p></div><div class="step"><div class="step-num">[05]</div><h3>Pregătim documentația</h3><p>Proiectul este documentat pentru etapa următoare.</p></div></div>
<hr class="section-divider"><span class="section-label">Avantaje</span><h2 class="section-title">De ce să lucrați<br>cu noi?</h2>{% set avantaje=[['Experiență tehnică','Înțelegem atât proiectarea, cât și realitatea din execuție.'],['Proiectare digitală','Utilizăm CAD, BIM și vizualizare 3D.'],['Soluții personalizate','Fiecare proiect este adaptat beneficiarului.'],['Comunicare clară','Explicăm etapele și documentele necesare.'],['Flexibilitate','Lucrăm cu beneficiari, arhitecți, dezvoltatori și constructori.'],['Colaborare la distanță','O parte importantă a proiectării poate fi realizată online.']] %}<div class="pillars">{% for a in avantaje %}<div class="pillar"><h3>{{ a[0] }}</h3><p>{{ a[1] }}</p></div>{% endfor %}</div>
<hr class="section-divider"><span class="section-label">Buget</span><h2 class="section-title">Cât costă un proiect<br>de arhitectură?</h2><p class="section-sub">Prețul depinde de suprafață, tipul clădirii, complexitate, documentația existentă, detaliere, modelare 3D, randări, modificări și serviciile solicitate.</p><div class="quote"><strong>Nu oferim un preț standard pentru toate proiectele.</strong><p>După o discuție și analiza cerințelor, pregătim o ofertă adaptată proiectului tău.</p><button class="btn-cta" onclick="openModal()">Cere o Ofertă</button></div>
<hr class="section-divider"><div class="cta"><h2>Proiectul dumneavoastră<br>începe cu o idee.</h2><p>O casă, un spațiu comercial, o renovare sau o extindere: transformăm ideea într-o soluție arhitecturală clară și bine documentată.</p><div class="motto">Proiectăm. Modelăm. Vizualizăm.</div><button class="btn-cta" onclick="openModal()">Solicită Ofertă</button></div></div>
