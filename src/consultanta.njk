<script>
var currentSlide=0,totalSlides=document.querySelectorAll('.slideshow-slide').length,track=document.getElementById('slideshow-track'),dots=document.getElementById('slideshow-dots'),counter=document.getElementById('slideshow-counter'),autoPlay;for(var i=0;i<totalSlides;i++){var dot=document.createElement('button');dot.className='slideshow-dot'+(i===0?' active':'');dot.onclick=(function(n){return function(){goToSlide(n)}})(i);dots.appendChild(dot)}function goToSlide(n){currentSlide=n;track.style.transform='translateX(-'+n*100+'%)';document.querySelectorAll('.slideshow-dot').forEach(function(d,i){d.classList.toggle('active',i===n)});counter.textContent=(n+1)+' / '+totalSlides}function nextSlide(){goToSlide((currentSlide+1)%totalSlides);resetAutoPlay()}function prevSlide(){goToSlide((currentSlide-1+totalSlides)%totalSlides);resetAutoPlay()}function resetAutoPlay(){clearInterval(autoPlay);autoPlay=setInterval(function(){goToSlide((currentSlide+1)%totalSlides)},5000)}resetAutoPlay();
</script>
