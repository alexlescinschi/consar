<style>
.container{max-width:1200px;margin:0 auto;padding:8rem 3rem 4rem}.section-divider{border:0;border-top:1px solid var(--border);margin:5rem 0}.section-label{display:block;margin-bottom:1rem;color:var(--text-dim);font-size:.65rem;letter-spacing:.3em;text-transform:uppercase}.section-title{margin-bottom:1rem;font-family:var(--font-serif);font-size:clamp(2rem,5vw,3.5rem);font-weight:400;line-height:1.1}.section-sub{max-width:650px;margin-bottom:2rem;color:var(--text-dim);font-size:1rem;line-height:1.7}.intro{position:relative;display:flex;min-height:100vh;flex-direction:column;justify-content:center;overflow:hidden;padding:6rem 3rem 5rem}.intro-content{position:relative;z-index:3;max-width:820px}.intro h1{margin-bottom:1.5rem;font-family:var(--font-serif);font-size:clamp(2.5rem,6vw,4.5rem);font-weight:400;line-height:1.05}.btn-cta{margin-top:1rem;padding:1.2rem 2.5rem;border:0;background:var(--accent);color:var(--bg);font-family:var(--font-sans);font-size:.75rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;cursor:pointer;transition:var(--transition)}.btn-cta:hover{outline:1px solid var(--accent);background:transparent;color:var(--accent)}
.slideshow{position:absolute;inset:0;z-index:1;overflow:hidden}.slideshow:after{position:absolute;inset:0;z-index:2;background:linear-gradient(to right,rgba(61,69,77,.92),rgba(61,69,77,.56),rgba(61,69,77,.78));content:''}.slideshow-track{display:flex;width:100%;height:100%;transition:transform 1s cubic-bezier(.16,1,.3,1)}.slideshow-slide{min-width:100%;height:100%}.slideshow-slide img{width:100%;height:100%;object-fit:cover}.slideshow-controls{position:absolute;top:50%;z-index:4;width:48px;height:48px;transform:translateY(-50%);border:1px solid rgba(233,228,223,.25);background:none;color:var(--accent);cursor:pointer;opacity:0;transition:var(--transition)}.slideshow:hover .slideshow-controls{opacity:1}.slideshow-prev{left:2rem}.slideshow-next{right:2rem}.slideshow-dots{position:absolute;right:3rem;bottom:2.5rem;z-index:4;display:flex;gap:.6rem}.slideshow-dot{width:7px;height:7px;padding:0;border:1px solid rgba(233,228,223,.4);border-radius:50%;background:transparent;cursor:pointer}.slideshow-dot.active{background:var(--accent)}.slideshow-counter{position:absolute;bottom:2.5rem;left:3rem;z-index:4;font-size:.65rem;letter-spacing:.2em;opacity:.5}
.split{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center;margin-top:3rem}.split-image{width:100%;max-width:480px;aspect-ratio:6/7;justify-self:end;overflow:hidden;border:1px solid var(--border)}.split-image img,.media img{width:100%;height:100%;object-fit:cover;filter:grayscale(100%) brightness(.65);transition:var(--transition)}.split-image:hover img,.card:hover .media img{filter:grayscale(0) brightness(.95)}.list{display:grid;grid-template-columns:1fr 1fr;gap:0 2rem;margin:0;padding:0;list-style:none;color:var(--text-dim);font-size:.8rem;line-height:2}.list li:before,.card li:before{content:'— ';opacity:.45}
.card-grid{display:grid;grid-template-columns:repeat(2,1fr);margin-top:3rem;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.card{border-right:1px solid var(--border);border-bottom:1px solid var(--border);transition:var(--transition)}.card:nth-child(2n){border-right:0}.card:nth-last-child(-n+2){border-bottom:0}.card:hover{background:var(--surface)}.media{height:210px;overflow:hidden;border-bottom:1px solid var(--border)}.body{padding:2rem}.number{margin-bottom:1rem;font-size:.7rem;opacity:.4}.body h3{margin-bottom:.8rem;font-family:var(--font-serif);font-size:1.45rem;font-weight:400}.body p,.card li{color:var(--text-dim);font-size:.78rem;line-height:1.7}.card ul{margin:1rem 0 0;padding:0;list-style:none}.note{margin-top:1rem;color:var(--text-dim);font-size:.72rem;font-style:italic;line-height:1.6}
.banner{position:relative;display:flex;min-height:390px;align-items:center;justify-content:center;overflow:hidden;margin-top:5rem;border:1px solid var(--border);text-align:center}.banner img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:grayscale(100%) brightness(.35)}.banner:after{position:absolute;inset:0;background:rgba(61,69,77,.45);content:''}.banner-content{position:relative;z-index:2;padding:3rem}.banner-quote{font-family:var(--font-serif);font-size:clamp(1.6rem,3.5vw,2.6rem);line-height:1.25}
.portfolio{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:3rem;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.portfolio-item{position:relative;aspect-ratio:4/3;overflow:hidden}.portfolio-item img{width:100%;height:100%;object-fit:cover;filter:grayscale(100%) brightness(.5);transition:var(--transition)}.portfolio-item:hover img{filter:grayscale(0) brightness(.9);transform:scale(1.06)}.overlay{position:absolute;right:0;bottom:0;left:0;padding:2rem;background:linear-gradient(transparent,rgba(61,69,77,.95));opacity:0;transform:translateY(15px);transition:var(--transition)}.portfolio-item:hover .overlay{opacity:1;transform:none}.overlay h4{margin-bottom:.3rem;font-family:var(--font-serif);font-size:1.2rem;font-weight:400}.overlay span{font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;opacity:.65}
.steps{display:grid;grid-template-columns:repeat(5,1fr);margin-top:3rem;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.step{padding:2.5rem 1.5rem;border-right:1px solid var(--border);transition:var(--transition)}.step:last-child{border-right:0}.step:hover{background:var(--surface)}.step-num{margin-bottom:1.3rem;font-size:.7rem;opacity:.4}.step h3{margin-bottom:.7rem;font-family:var(--font-serif);font-size:1.15rem;font-weight:400}.step p{color:var(--text-dim);font-size:.75rem;line-height:1.65}.pillars{display:grid;grid-template-columns:repeat(3,1fr);margin-top:3rem;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}.pillar{padding:2.5rem 2rem;border-right:1px solid var(--border);border-bottom:1px solid var(--border);transition:var(--transition)}.pillar:nth-child(3n){border-right:0}.pillar:nth-last-child(-n+3){border-bottom:0}.pillar:hover{background:var(--surface)}.pillar h3{margin-bottom:.7rem;font-family:var(--font-serif);font-size:1.3rem;font-weight:400}.pillar p{color:var(--text-dim);font-size:.78rem;line-height:1.7}.quote{padding:3rem;border:1px solid var(--border);background:var(--surface);text-align:center}.quote strong{display:block;margin-bottom:1rem;font-family:var(--font-serif);font-size:clamp(1.4rem,3vw,2rem);font-weight:400}.quote p{max-width:560px;margin:auto;color:var(--text-dim);font-size:.85rem;line-height:1.7}.cta{padding:5rem 3rem;border:1px solid var(--border);background:var(--surface);text-align:center}.cta h2{font-family:var(--font-serif);font-size:clamp(2rem,4vw,3rem);font-weight:400}.cta p{max-width:600px;margin:1rem auto;color:var(--text-dim);line-height:1.7}.motto{margin:2rem 0;font-family:var(--font-serif);font-size:1.4rem}
@media(max-width:768px){.container{padding:6rem 1.5rem 3rem}.intro{min-height:70vh;padding:5rem 1.5rem 3rem}.slideshow-controls{width:36px;height:36px;opacity:1}.slideshow-prev{left:1rem}.slideshow-next{right:1rem}.slideshow-dots{right:1.5rem;bottom:1.5rem}.slideshow-counter{bottom:1.5rem;left:1.5rem}.split,.card-grid,.pillars,.portfolio{grid-template-columns:1fr}.split-image{justify-self:stretch;max-width:none;aspect-ratio:16/10}.list{grid-template-columns:1fr}.card,.pillar{border-right:0}.card:nth-last-child(-n+2),.pillar:nth-last-child(-n+3){border-bottom:1px solid var(--border)}.card:last-child,.pillar:last-child{border-bottom:0}.steps{grid-template-columns:1fr}.step{border-right:0;border-bottom:1px solid var(--border)}.step:last-child{border-bottom:0}.cta{padding:3rem 1.5rem}}
</style>

<section class="intro"><div class="slideshow"><div class="slideshow-track" id="slideshow-track">{% for i in [1,2,3,4,5,6] %}<div class="slideshow-slide"><img src="/images/consultanta/hero-0{{ i }}.jpg" alt="Consultanță construcții {{ i }}" onerror="this.onerror=null;this.src='/images/consultanta/ph/hero-0{{ i }}.svg';"></div>{% endfor %}</div><button class="slideshow-controls slideshow-prev" onclick="prevSlide()">&#8592;</button><button class="slideshow-controls slideshow-next" onclick="nextSlide()">&#8594;</button><div class="slideshow-dots" id="slideshow-dots"></div><div class="slideshow-counter" id="slideshow-counter">1 / 6</div></div><div class="intro-content"><span class="section-label">Consultanță în Construcții și Renovări</span><h1>Ia deciziile corecte<br>înainte să începi.</h1><p class="section-sub" style="font-size:1.1rem">Control mai bun asupra proiectului, bugetului și lucrărilor.</p><p class="section-sub">Te ajutăm să analizezi proiecte, devize, materiale și etape de execuție, astfel încât să construiești sau să renovezi informat.</p><button class="btn-cta" onclick="openModal()">Solicită o Consultație</button></div></section>

<div class="container"><hr class="section-divider"><span class="section-label">Consultanță pentru Proiectul Tău</span><h2 class="section-title">Să știi ce cumperi,<br>ce construiești și cât costă.</h2><p class="section-sub">Oferim consultanță pentru proprietari, investitori și beneficiari care vor să construiască, să renoveze sau să achiziționeze o proprietate.</p><div class="split"><div><ul class="list"><li>Analiză tehnică</li><li>Analiză constructivă</li><li>Analiză financiară</li><li>Organizarea lucrărilor</li><li>Materiale potrivite</li><li>Oferte și devize primite</li><li>Etape de execuție</li></ul><p class="section-sub" style="margin-top:2rem">O consultație corectă la început te poate ajuta să eviți costuri mult mai mari ulterior.</p></div><div class="split-image"><img src="/images/consultanta/analiza.jpg" alt="Analiză proiect" onerror="this.onerror=null;this.src='/images/consultanta/ph/analiza.svg';"></div></div>

<hr class="section-divider"><span class="section-label">Serviciile Noastre</span><h2 class="section-title">Analizăm înainte<br>să devină costisitor.</h2>{% set servicii=[['Consultanță înainte de construcție','Începi cu o imagine clară asupra investiției și etapelor proiectului.',['Documentație necesară','Specialiști și lucrări de bugetat','Materiale și etape principale']],['Consultanță pentru renovări','Nu începi renovarea fără un plan.',['Lucrări necesare și evitabile','Ordinea corectă a intervențiilor','Instalații, finisaje și buget']],['Verificarea ofertelor și devizelor','Compari mai ușor ofertele și identifici costurile ascunse.',['Cantități și prețuri','Lucrări incluse sau lipsă','Materiale, manoperă și costuri suplimentare']],['Estimarea costului construcției','Stabilești un buget realist înainte să începi.',['Suprafață și proiect','Sistem constructiv și finisare','Materiale, instalații și exterior']],['Alegerea materialelor','Căutăm soluția potrivită pentru proiect și buget.',['Zidărie și termoizolație','Acoperiș și tâmplărie','Finisaje, pardoseli și instalații']],['Alegerea constructorului','Analizezi ofertele și condițiile diferiților executanți.',['Experiență și preț','Termen, avans și garanție','Contract și responsabilități']],['Consultanță pe parcursul execuției','Evaluări punctuale atunci când ai nevoie de o a doua opinie.',['Progres și respectarea proiectului','Calitatea aparentă a execuției','Materiale și situații de lucrări']],['Evaluare înainte de cumpărare','Înțelegi investițiile suplimentare probabile ale unei proprietăți.',['Starea construcției și finisajelor','Instalațiile vizibile','Necesar de renovare']]] %}<div class="card-grid">{% for s in servicii %}<article class="card"><div class="media"><img src="/images/consultanta/serv-0{{ loop.index }}.jpg" alt="{{ s[0] }}" onerror="this.onerror=null;this.src='/images/consultanta/ph/thumb-0{{ loop.index }}.svg';"></div><div class="body"><div class="number">[0{{ loop.index }}]</div><h3>{{ s[0] }}</h3><p>{{ s[1] }}</p><ul>{% for x in s[2] %}<li>{{ x }}</li>{% endfor %}</ul></div></article>{% endfor %}</div>
<div class="banner"><img src="/images/consultanta/banner.jpg" alt="" onerror="this.onerror=null;this.src='/images/consultanta/ph/banner.svg';"><div class="banner-content"><span class="section-label" style="color:var(--accent);opacity:.6">Consultanță Corectă</span><p class="banner-quote">„Înainte să cheltuiești bani,<br>asigură-te că știi pentru ce plătești."</p></div></div>

<hr class="section-divider"><span class="section-label">Pentru Investitori și Dezvoltatori</span><h2 class="section-title">Control mai bun<br>al investiției.</h2><p class="section-sub">Suport pentru persoane și companii care dezvoltă proiecte imobiliare.</p><div class="pillars"><div class="pillar"><h3>Costuri</h3><p>Estimări preliminare, analiza ofertelor și optimizarea deciziilor financiare.</p></div><div class="pillar"><h3>Organizare</h3><p>Analiza etapelor de execuție, coordonarea furnizorilor și executanților.</p></div><div class="pillar"><h3>Soluții</h3><p>Alegerea soluțiilor constructive potrivite proiectului și bugetului.</p></div></div>

<hr class="section-divider"><span class="section-label">Proces</span><h2 class="section-title">Cum se desfășoară<br>o consultație?</h2><div class="steps"><div class="step"><div class="step-num">[01]</div><h3>Discutăm proiectul</h3><p>Ne explici ce vrei să construiești, renovezi sau verifici.</p></div><div class="step"><div class="step-num">[02]</div><h3>Analizăm informațiile</h3><p>Ne trimiți proiecte, fotografii, oferte, devize sau documente disponibile.</p></div><div class="step"><div class="step-num">[03]</div><h3>Identificăm problemele</h3><p>Analizăm riscurile, costurile și aspectele care necesită atenție.</p></div><div class="step"><div class="step-num">[04]</div><h3>Oferim recomandări</h3><p>Primești explicații și recomandări practice pentru etapa următoare.</p></div><div class="step"><div class="step-num">[05]</div><h3>Stabilim pașii</h3><p>Continuăm cu proiectare, estimare, execuție sau coordonare, când este necesar.</p></div></div>

<hr class="section-divider"><span class="section-label">Consultanță Online</span><h2 class="section-title">O opinie profesională,<br>oriunde este proiectul.</h2><p class="section-sub">Pentru anumite situații, o vizită fizică nu este necesară.</p><div class="pillars"><div class="pillar"><h3>WhatsApp și video call</h3><p>Discutăm rapid situația și analizăm fotografiile sau detaliile transmise.</p></div><div class="pillar"><h3>E-mail și documente</h3><p>Analizăm proiecte, oferte, devize, planuri și informații scrise.</p></div><div class="pillar"><h3>Proiecte la distanță</h3><p>Poți primi recomandări chiar dacă proprietatea este în altă localitate.</p></div></div>

<hr class="section-divider"><span class="section-label">Avantaje</span><h2 class="section-title">De ce să apelezi<br>la consultanță?</h2>{% set avantaje=[['Evită greșelile costisitoare','O decizie greșită în proiectare sau execuție poate genera costuri suplimentare importante.'],['Înțelege oferta constructorului','Știi exact ce plătești și ce lucrări sunt incluse.'],['Controlează bugetul','Ai o imagine mai clară asupra costurilor și etapelor proiectului.'],['Alege soluții potrivite','Comparăm alternativele și alegem soluția potrivită proiectului și bugetului.'],['Câștigă timp','Primești răspunsuri practice fără să cauți informații din mai multe surse.']] %}<div class="pillars">{% for a in avantaje %}<div class="pillar"><h3>{{ a[0] }}</h3><p>{{ a[1] }}</p></div>{% endfor %}</div>

<hr class="section-divider"><span class="section-label">Pachete</span><h2 class="section-title">Cât costă consultanța?</h2><p class="section-sub">Prețul depinde de tipul și complexitatea solicitării.</p><div class="pillars"><div class="pillar"><h3>Consultație punctuală</h3><p>Pentru o întrebare sau o problemă concretă.</p></div><div class="pillar"><h3>Analiză ofertă / deviz</h3><p>Pentru verificarea unei oferte primite de la constructor.</p></div><div class="pillar"><h3>Consultanță pentru proiect</h3><p>Suport pentru proprietari aflați în etapa de planificare.</p></div><div class="pillar"><h3>Pe parcursul execuției</h3><p>Verificări și recomandări pe durata lucrărilor.</p></div><div class="pillar"><h3>Pachet de consultanță</h3><p>Suport pentru proiecte care necesită ajutor în mai multe etape.</p></div></div><div class="quote" style="margin-top:3rem"><strong>Prețul se stabilește în funcție de serviciul solicitat și volumul de lucru.</strong><p>Trimite-ne proiectul, devizul, oferta constructorului sau fotografiile și explică-ne problema pe scurt.</p><button class="btn-cta" onclick="openModal()">Solicită o Consultație</button></div>

<hr class="section-divider"><div class="cta"><h2>Construiește informat.<br>Renovează cu un plan.</h2><p>O construcție bine organizată începe cu decizii bune. Nu aștepta până când problema devine costisitoare.</p><div class="motto">Analizăm. Recomandăm. Clarificăm.</div><button class="btn-cta" onclick="openModal()">Solicită Consultație</button></div></div>
