<style>
.hero-matrix {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    padding-top: 8rem;
    border-bottom: 1px solid var(--border);
}

.matrix-cell {
    position: relative;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2.5rem;
    transition: var(--transition);
}

.matrix-cell:nth-child(3n) {
    border-right: none;
}

.title-cell {
    padding: 2.5rem;
    justify-content: center;
}

.title-cell h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1.05;
    font-weight: 400;
    margin-bottom: 2rem;
}

.title-cell .metadata {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--text-dim);
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
}

.service-card {
    padding: 0;
    justify-content: flex-start;
    background: var(--surface);
}

.service-card .bg-img {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-size: cover;
    background-position: center;
    transition: var(--transition);
    z-index: 1;
}

.service-card:hover .bg-img {
    transform: scale(1.05);
}

.service-card .content {
    position: relative;
    z-index: 2;
    padding: 1.5rem;
}

.card-num {
    position: absolute;
    top: 2.5rem;
    left: 2.5rem;
    font-size: 0.7rem;
    font-family: var(--font-sans);
    opacity: 0.4;
    z-index: 2;
}

.service-card h2 {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    margin-bottom: 0.5rem;
    font-weight: 400;
}

.sub-services {
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--text-dim);
    max-width: 280px;
}

.blog-preview-card {
    padding: 0;
    justify-content: flex-start;
    background: var(--surface);
    color: var(--accent);
    text-decoration: none;
}

.blog-preview-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
}

.blog-preview-content { padding: 1.5rem; }
.blog-preview-content h3 { font-family: var(--font-serif); font-size: 1.5rem; font-weight: 400; line-height: 1.15; margin-top: 0.5rem; }

.home-contact-card {
    justify-content: center;
    background: var(--accent);
    color: var(--bg);
}

.view-btn {
    background: var(--accent);
    color: var(--bg);
    border: none;
    padding: 1rem 2rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-top: 2rem;
    cursor: pointer;
    transition: var(--transition);
}

.view-btn:hover {
    background: transparent;
    color: var(--accent);
    outline: 1px solid var(--accent);
}

@media (max-width: 1024px) {
    .hero-matrix { grid-template-columns: 1fr 1fr; }
    .matrix-cell:nth-child(3n) { border-right: 1px solid var(--border); }
    .matrix-cell:nth-child(2n) { border-right: none; }
}
@media (max-width: 768px) {
    .hero-matrix { grid-template-columns: 1fr; }
    .title-cell { padding: 3rem 1.5rem; min-height: auto; }
    .title-cell h1 { font-size: clamp(1.8rem, 6vw, 2.5rem); }
    .matrix-cell { border-right: none; }
    .service-card { padding: 0; }
    .service-card h2 { font-size: 1.5rem; }
    .card-num { top: 1.5rem; left: 1.5rem; }
}
</style>

