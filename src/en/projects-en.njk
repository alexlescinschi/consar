---
layout: base.njk
lang: en
title: Projects
nav_active: projects
permalink: /en/projects/
---

<style>
.portfolio-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin-top: 3rem;
}
.portfolio-item {
    position: relative;
    cursor: pointer;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    transition: var(--transition);
}
.portfolio-item:nth-child(3n) { border-right: none; }
.portfolio-item a {
    display: block;
    color: var(--accent);
    text-decoration: none;
}
.portfolio-img {
    aspect-ratio: 4/3;
    overflow: hidden;
}
.portfolio-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}
.portfolio-item:hover img {
    transform: scale(1.05);
}
.portfolio-info {
    padding: 1.5rem;
}
.portfolio-info h4 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 400;
    margin-bottom: 0.3rem;
}
.portfolio-info span {
    font-size: 0.75rem;
    color: var(--text-dim);
    display: block;
}

@media (max-width: 1024px) {
    .portfolio-grid { grid-template-columns: 1fr 1fr; }
    .portfolio-item:nth-child(3n) { border-right: 1px solid var(--border); }
    .portfolio-item:nth-child(2n) { border-right: none; }
}
@media (max-width: 768px) {
    .portfolio-grid { grid-template-columns: 1fr; }
    .portfolio-item { border-right: none; }
}
</style>

<div class="container">
    <span class="section-label">Portfolio</span>
    <h1 class="section-title">Completed<br>Projects</h1>
    <p class="section-sub">A selection of projects illustrating the diversity and quality of our architectural approach.</p>

    <div class="portfolio-grid">
        {% set projects = collections.projects_en | reverse %}
        {% for proj in projects %}
        <div class="portfolio-item">
            {% set hero = proj.data.blocks[0] %}
            {% set locatie = '' %}
            {% set an = '' %}
            {% for f in hero.tech_fields %}
                {% if f.label == 'Location' %}{% set locatie = f.value %}{% endif %}
                {% if f.label == 'Project year' %}{% set an = f.value %}{% endif %}
            {% endfor %}
            <a href="{{ proj.url }}">
                <div class="portfolio-img"><img src="{{ hero.image }}" alt="{{ proj.data.title }}" loading="lazy"></div>
                <div class="portfolio-info">
                    <h4>{{ proj.data.title }}</h4>
                    <span>{{ locatie }}{% if an %}, {{ an }}{% endif %}</span>
                </div>
            </a>
        </div>
        {% else %}
        <p style="color: var(--text-dim); padding: 2rem;">No projects published yet.</p>
        {% endfor %}
    </div>
</div>
