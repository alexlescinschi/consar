{# ============================================================
   COMPONENTĂ PARTAJATĂ — Modal "Solicită Ofertă"
   Configurare: src/_data/oferta.yml
   Pagina setează în frontmatter:  varianta_oferta: arhitectura | reparatii | interior-design
   ============================================================ #}
{% set v = oferta[varianta_oferta] %}
{% set iconuri = {
    'house': '<path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><path d="M9 21V12h6v9"/>',
    'comercial': '<rect x="2" y="3" width="20" height="18" rx="1"/><path d="M8 21v-4h8v4"/><path d="M12 7v4"/><path d="M8 9h8"/>',
    'public': '<rect x="2" y="3" width="20" height="18" rx="1"/><path d="M6 3v18"/><path d="M2 9h22"/><path d="M12 12h4"/>',
    'industrial': '<path d="M2 20h20"/><path d="M5 20V6l7-3v17"/><path d="M19 20V12l-7-3"/><path d="M9 12h4"/><path d="M16 12h3"/>',
    'turism': '<rect x="2" y="5" width="20" height="16" rx="1"/><path d="M6 12h4v4H6z"/><path d="M14 12h4v4h-4z"/><path d="M10 5V2h4v3"/>',
    'urbanism': '<circle cx="8" cy="18" r="2"/><circle cx="16" cy="18" r="2"/><path d="M4 18c0-5 3-9 8-9s8 4 8 9"/><path d="M12 9V3"/><path d="M9 3h6"/>',
    'renov': '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94L2 24l4.53-11.53a6 6 0 0 1 7.94-7.94l.77.77"/>',
    'apartament': '<rect x="4" y="2" width="16" height="20" rx="1"/><path d="M9 7h2"/><path d="M13 7h2"/><path d="M9 11h2"/><path d="M13 11h2"/><path d="M9 15h2"/><path d="M13 15h2"/><path d="M10 22v-3h4v3"/>',
    'casa': '<path d="M3 10L12 3l9 7"/><path d="M5 9v12h14V9"/><path d="M10 21v-6h4v6"/>',
    'spatiu': '<path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-4h6v4"/><path d="M12 3v4"/>',
    'birou': '<rect x="3" y="4" width="18" height="12" rx="1"/><path d="M8 21h8"/><path d="M12 16v5"/><path d="M7 9h4"/><path d="M7 12h7"/>'
} %}

<style>
/* MODAL (componentă partajată) */
.modal-overlay {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(61, 69, 77, 0.92);
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s;
}
.modal-overlay.active { opacity: 1; pointer-events: all; }
.modal {
    background: var(--surface);
    border: 1px solid var(--border);
    width: 90%;
    max-width: 700px;
    max-height: 85vh;
    overflow-y: auto;
    padding: 3rem;
    position: relative;
}
.modal-close {
    position: absolute;
    top: 1.5rem; right: 1.5rem;
    background: none;
    border: none;
    color: var(--accent);
    font-size: 1.5rem;
    cursor: pointer;
    opacity: 0.5;
    transition: var(--transition);
    line-height: 1;
}
.modal-close:hover { opacity: 1; }
.modal-step { display: none; }
.modal-step.active {
    display: block;
    animation: fadeSlideIn 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}
@keyframes fadeSlideIn {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
}
.modal h3 {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 400;
    margin-bottom: 0.5rem;
}
.modal .modal-sub {
    font-size: 0.8rem;
    color: var(--text-dim);
    margin-bottom: 1.5rem;
}
.modal .step-indicator {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.35em;
    color: var(--text-dim);
    margin-bottom: 2rem;
    display: block;
}
.modal .radio-group,
.modal .checkbox-group {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
}
.modal .radio-group { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
.modal .checkbox-group { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
.modal .radio-item,
.modal .checkbox-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    cursor: pointer;
    transition: var(--transition);
    font-size: 0.8rem;
}
.modal .radio-item:hover,
.modal .checkbox-item:hover {
    border-color: rgba(233, 228, 223, 0.3);
    background: rgba(233, 228, 223, 0.03);
}
.modal .radio-item input,
.modal .checkbox-item input {
    appearance: none;
    -webkit-appearance: none;
    width: 14px; height: 14px;
    border: 1px solid var(--text-dim);
    border-radius: 50%;
    flex-shrink: 0;
    cursor: pointer;
    transition: var(--transition);
    position: relative;
}
.modal .checkbox-item input { border-radius: 0; }
.modal .radio-item input:checked {
    border-color: var(--accent);
    background: var(--accent);
}
.modal .checkbox-item input:checked {
    border-color: var(--accent);
    background: var(--accent);
}
.modal .checkbox-item input:checked::after {
    content: '';
    position: absolute;
    left: 4px; top: 1px;
    width: 4px; height: 8px;
    border: solid var(--bg);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
}
.modal .radio-icon {
    opacity: 0.35;
    transition: var(--transition);
    flex-shrink: 0;
}
.modal .radio-item input:checked ~ .radio-icon { opacity: 0.8; }
.modal .radio-item input:checked ~ span,
.modal .checkbox-item input:checked ~ span { color: var(--accent); }
.modal .checkbox-thumb {
    width: 40px;
    height: 40px;
    object-fit: cover;
    border-radius: 2px;
    flex-shrink: 0;
    opacity: 0.65;
    transition: var(--transition);
}
.modal .checkbox-item input:checked ~ .checkbox-thumb,
.modal .checkbox-item:hover .checkbox-thumb { opacity: 1; }
.modal .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1rem;
}
.modal .field-group label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
}
.modal .field-group input,
.modal .field-group textarea,
.modal .field-group select {
    background: var(--bg);
    border: 1px solid var(--border);
    color: var(--accent);
    padding: 0.8rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    transition: var(--transition);
    outline: none;
    width: 100%;
}
.modal .field-group input:focus,
.modal .field-group textarea:focus,
.modal .field-group select:focus { border-color: rgba(233, 228, 223, 0.4); }
.modal .contact-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
}
.modal .btn-row {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
}
.modal .btn-next,
.modal .btn-back {
    background: var(--accent);
    color: var(--bg);
    border: none;
    padding: 0.9rem 2rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: var(--transition);
    font-family: var(--font-sans);
}
.modal .btn-back {
    background: transparent;
    color: var(--text-dim);
    border: 1px solid var(--border);
}
.modal .btn-next:hover {
    background: transparent;
    color: var(--accent);
    outline: 1px solid var(--accent);
}
.modal .btn-back:hover {
    color: var(--accent);
    border-color: rgba(233, 228, 223, 0.4);
}
.modal .sub-details {
    margin-top: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    background: rgba(61, 69, 77, 0.4);
}
.modal .sub-details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
}
.modal .checkbox-bool {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    margin-top: 0.3rem;
}
.modal .sub-section-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 400;
    margin: 1.5rem 0 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
}
.modal .sub-section-title:first-of-type {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
}
.modal .attach-note {
    font-size: 0.72rem;
    color: var(--text-dim);
    line-height: 1.6;
    margin-top: 0.5rem;
}

@media (max-width: 768px) {
    .modal { padding: 2rem; width: 95%; }
    .modal .contact-row { grid-template-columns: 1fr; }
    .modal .radio-group,
    .modal .checkbox-group { grid-template-columns: 1fr; }
    .modal .sub-details-grid { grid-template-columns: 1fr; }
}
</style>

<!-- MODAL OFERTĂ -->
<div class="modal-overlay" id="modal-overlay" role="dialog" aria-modal="true" aria-label="Solicită ofertă">
    <div class="modal">
        <button class="modal-close" onclick="closeModal()" aria-label="Închide">&times;</button>

        <!-- Pasul 1 -->
        <div class="modal-step active" data-step="1">
            <span class="step-indicator">Pasul 1 / 4</span>
            <h3>{{ v.pas1_titlu }}</h3>
            <p class="modal-sub">{{ v.pas1_sub }}</p>
            <div class="radio-group">
                {% for opt in v.pas1 %}
                <label class="radio-item">
                    <input type="radio" name="categorie" value="{{ opt.valoare }}" onchange="onCatChange(this)">
                    {% if opt.icon and iconuri[opt.icon] %}<svg class="radio-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">{{ iconuri[opt.icon] | safe }}</svg>{% endif %}
                    <span>{{ opt.valoare }}</span>
                </label>
                {% endfor %}
            </div>
            <div class="btn-row">
                <button class="btn-next" onclick="nextStep(2)">Continuă →</button>
            </div>
        </div>

        <!-- Pasul 2 -->
        <div class="modal-step" data-step="2">
            <span class="step-indicator">Pasul 2 / 4</span>
            <h3>{{ v.pas2_titlu }}</h3>

            {% if varianta_oferta == 'arhitectura' %}
            <div id="step2-residential">
                <div class="sub-section-title">A. Tipul de locuință și dimensiuni</div>

                <div class="sub-details">
                    <label class="checkbox-item" style="margin-bottom: 1rem;">
                        <input type="checkbox" class="house-type" data-type="individuala" onchange="toggleHouseFields()">
                        <img class="checkbox-thumb" src="/images/thumbnails/1.jpg" alt="" loading="lazy"><span>1) Casă individuală</span>
                    </label>
                    <div class="sub-details-grid house-fields" data-type="individuala" style="display: none;">
                        <div class="field-group"><label>Lungime (m)</label><input type="number" step="0.1" placeholder="ex: 15"></div>
                        <div class="field-group"><label>Lățime (m)</label><input type="number" step="0.1" placeholder="ex: 10"></div>
                        <div class="field-group"><label>Nr. etaje</label><input type="number" placeholder="ex: 2"></div>
                        <div class="checkbox-bool"><input type="checkbox"> Subsol</div>
                    </div>
                </div>

                <div class="sub-details" style="margin-top: 1rem;">
                    <label class="checkbox-item" style="margin-bottom: 1rem;">
                        <input type="checkbox" class="house-type" data-type="duplex" onchange="toggleHouseFields()">
                        <img class="checkbox-thumb" src="/images/thumbnails/2.jpg" alt="" loading="lazy"><span>2) Casă duplex</span>
                    </label>
                    <div class="sub-details-grid house-fields" data-type="duplex" style="display: none;">
                        <div class="field-group"><label>Lungime (m)</label><input type="number" step="0.1" placeholder="ex: 18"></div>
                        <div class="field-group"><label>Lățime (m)</label><input type="number" step="0.1" placeholder="ex: 12"></div>
                        <div class="checkbox-bool"><input type="checkbox"> Subsol</div>
                    </div>
                </div>

                <div class="sub-details" style="margin-top: 1rem;">
                    <label class="checkbox-item" style="margin-bottom: 1rem;">
                        <input type="checkbox" class="house-type" data-type="townhouse" onchange="toggleHouseFields()">
                        <img class="checkbox-thumb" src="/images/thumbnails/3.jpg" alt="" loading="lazy"><span>3) Casă înșiruită (townhouse)</span>
                    </label>
                    <div class="sub-details-grid house-fields" data-type="townhouse" style="display: none;">
                        <div class="field-group"><label>Lungime (m)</label><input type="number" step="0.1" placeholder="ex: 12"></div>
                        <div class="field-group"><label>Lățime (m)</label><input type="number" step="0.1" placeholder="ex: 6"></div>
                        <div class="field-group"><label>Nr. etaje</label><input type="number" placeholder="ex: 2"></div>
                        <div class="checkbox-bool"><input type="checkbox"> Subsol</div>
                    </div>
                </div>

                <div class="sub-section-title">B. Stil, Materiale și Tehnologie</div>
                <div class="checkbox-group">
                    {% for s in v.stil %}
                    <label class="checkbox-item"><input type="checkbox" name="stil" value="{{ s.nume }}"><img class="checkbox-thumb" src="{{ s.thumb }}" alt="" loading="lazy"><span>{{ s.nume }}</span></label>
                    {% endfor %}
                </div>
            </div>

            <div id="step2-generic" style="display: none;">
                <div class="field-group">
                    <label>Descrie proiectul tău</label>
                    <textarea rows="4" name="descriere_proiect" placeholder="Detalii despre proiect: tip clădire, suprafață estimativă, specificații..."></textarea>
                </div>
            </div>
            {% else %}
            <p class="modal-sub">{{ v.pas2_sub }}</p>
            <div class="checkbox-group">
                {% for l in v.lucrari %}
                <label class="checkbox-item"><input type="checkbox" name="lucrari" value="{{ l.nume }}"><img class="checkbox-thumb" src="{{ l.thumb }}" alt="" loading="lazy" data-ph="{{ l.ph }}" onerror="this.onerror=null;this.src=this.dataset.ph;"><span>{{ l.nume }}</span></label>
                {% endfor %}
            </div>
            <div class="field-group">
                <label>Alte detalii (opțional)</label>
                <textarea rows="3" name="detalii_lucrari" placeholder="{{ v.pas2_placeholder or 'Ex: detalii suplimentare despre proiect...' }}"></textarea>
            </div>
            {% endif %}

            <div class="btn-row">
                <button class="btn-back" onclick="prevStep(1)">← Înapoi</button>
                <button class="btn-next" onclick="nextStep(3)">Continuă →</button>
            </div>
        </div>

        <!-- Pasul 3 -->
        <div class="modal-step" data-step="3">
            {% if varianta_oferta == 'arhitectura' %}
            <span class="step-indicator">Pasul 3 / 4 (Opțional)</span>
            <h3>{{ v.pas3_titlu }}</h3>
            <p class="modal-sub">{{ v.pas3_sub }}</p>
            <div class="checkbox-group">
                {% for r in v.randari %}
                <label class="checkbox-item"><input type="checkbox" name="randari" value="{{ r }}"><span>{{ r }}</span></label>
                {% endfor %}
            </div>
            {% else %}
            <span class="step-indicator">Pasul 3 / 4</span>
            <h3>{{ v.pas3_titlu }}</h3>
            <p class="modal-sub">{{ v.pas3_sub }}</p>
            <div class="sub-details">
                <div class="sub-details-grid">
                    {% for c in v.pas3_campuri %}
                    <div class="field-group"><label>{{ c.label }}</label><input type="{{ c.tip }}" name="{{ c.nume }}" placeholder="{{ c.placeholder }}"></div>
                    {% endfor %}
                </div>
                <p class="attach-note">Poți atașa și planul spațiului, fotografii sau video — le poți trimite ulterior pe WhatsApp sau la info@consarhouse.md.</p>
            </div>
            {% endif %}
            <div class="btn-row">
                <button class="btn-back" onclick="prevStep(2)">← Înapoi</button>
                <button class="btn-next" onclick="nextStep(4)">Continuă →</button>
            </div>
        </div>

        <!-- Pasul 4 -->
        <div class="modal-step" data-step="4">
            <span class="step-indicator">Pasul 4 / 4</span>
            <h3>Date de Contact</h3>
            <p class="modal-sub">Completează datele și trimite solicitarea.</p>
            <div class="contact-row">
                <div class="field-group"><label>Nume și Prenume *</label><input type="text" id="form-nume" required placeholder="Numele tău complet"></div>
                <div class="field-group"><label>Email *</label><input type="email" id="form-email" required placeholder="email@exemplu.ro"></div>
            </div>
            <div class="field-group"><label>Telefon *</label><input type="tel" id="form-telefon" required placeholder="07xx xxx xxx"></div>
            <div class="field-group"><label>Mesaj / Detalii suplimentare</label><textarea rows="4" id="form-mesaj" placeholder="Data estimativă de începere, alte detalii..."></textarea></div>
            <div class="btn-row">
                <button class="btn-back" onclick="prevStep(3)">← Înapoi</button>
                <button class="btn-next" onclick="submitForm()">Trimite Solicitarea →</button>
            </div>
        </div>
    </div>
</div>

<script>
/* MODAL OFERTĂ (componentă partajată) */
function openModal() {
    document.getElementById('modal-overlay').classList.add('active');
    document.body.style.overflow = 'hidden';
    goToStep(1);
}
function closeModal() {
    document.getElementById('modal-overlay').classList.remove('active');
    document.body.style.overflow = '';
}
document.getElementById('modal-overlay').addEventListener('click', function(e) {
    if (e.target === this) closeModal();
});
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeModal();
});

function goToStep(n) {
    document.querySelectorAll('.modal-step').forEach(function(s) { s.classList.remove('active'); });
    var step = document.querySelector('.modal-step[data-step="' + n + '"]');
    if (step) step.classList.add('active');
    document.querySelector('.modal').scrollTo(0, 0);
}
function nextStep(n) { goToStep(n); }
function prevStep(n) { goToStep(n); }

function onCatChange(radio) {
    var step2r = document.getElementById('step2-residential');
    var step2g = document.getElementById('step2-generic');
    if (!step2r || !step2g) return;
    if (radio.value === 'Construcții rezidențiale') {
        step2r.style.display = 'block';
        step2g.style.display = 'none';
    } else {
        step2r.style.display = 'none';
        step2g.style.display = 'block';
    }
}

function toggleHouseFields() {
    document.querySelectorAll('.house-type').forEach(function(cb) {
        var fields = document.querySelector('.house-fields[data-type="' + cb.dataset.type + '"]');
        if (fields) fields.style.display = cb.checked ? 'grid' : 'none';
    });
}

function submitForm() {
    var nume = document.getElementById('form-nume').value.trim();
    var email = document.getElementById('form-email').value.trim();
    var telefon = document.getElementById('form-telefon').value.trim();
    if (!nume || !email || !telefon) {
        alert('Te rugăm să completezi toate câmpurile obligatorii (*).');
        return;
    }
    var cat = document.querySelector('input[name="categorie"]:checked');
    if (!cat) {
        alert('Te rugăm să faci o selecție la Pasul 1.');
        goToStep(1);
        return;
    }
    var sel = [];
    document.querySelectorAll('#modal-overlay input[type="checkbox"]:checked').forEach(function(i) {
        if (i.value) sel.push(i.value);
    });
    var mesaj = '✓ Solicitarea a fost trimisă cu succes!\n\n' +
        'Tip: ' + cat.value + '\n' +
        (sel.length ? 'Lucrări/Opțiuni: ' + sel.join(', ') + '\n' : '') +
        'Nume: ' + nume + '\n' +
        'Email: ' + email + '\n\n' +
        'Te vom contacta în maxim 48 de ore.';
    alert(mesaj);
    closeModal();
}
</script>
