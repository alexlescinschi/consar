{# ============================================================
   BANDĂ DE PROIECTE REALE — filtrată pe serviciul paginii
   Folosire:  {% set serviciu_key = 'constructii-case' %}
              {% include "projects-strip.njk" %}
   Chei disponibile: arhitectura, proiectare-arhitecturala,
   constructii-case, interior-design, reparatii, desen-tehnic, consultanta
   ============================================================ #}
{% set strip_matched = [] %}
{% for strip_proj in collections.projects_ro %}
    {% if strip_proj.data.servicii and strip_proj.data.servicii.indexOf(serviciu_key) > -1 %}
        {% if strip_matched.push(strip_proj) %}{% endif %}
    {% endif %}
{% endfor %}

{% if strip_matched.length > 0 %}
<style>
.projects-strip { margin-top: 3rem; }
.strip-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
}
.strip-card {
    display: block;
    border-right: 1px solid var(--border);
    background: var(--surface);
    color: var(--accent);
    text-decoration: none;
    transition: var(--transition);
}
.strip-card:nth-child(3n) { border-right: none; }
.strip-img {
    aspect-ratio: 4/3;
    overflow: hidden;
}
.strip-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}
.strip-card:hover img {
    transform: scale(1.05);
}
.strip-info { padding: 1.5rem; }
.strip-info h4 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 400;
    margin-bottom: 0.3rem;
}
.strip-info span {
    font-size: 0.75rem;
    color: var(--text-dim);
    display: block;
}
.strip-btn {
    display: inline-block;
    background: var(--accent);
    color: var(--bg);
    border: none;
    padding: 1rem 2.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    text-decoration: none;
    transition: var(--transition);
}
.strip-btn:hover {
    background: transparent;
    color: var(--accent);
    outline: 1px solid var(--accent);
}
@media (max-width: 1024px) {
    .strip-grid { grid-template-columns: 1fr 1fr; }
    .strip-card:nth-child(3n) { border-right: 1px solid var(--border); }
    .strip-card:nth-child(2n) { border-right: none; }
}
@media (max-width: 768px) {
    .strip-grid { grid-template-columns: 1fr; }
    .strip-card { border-right: none; }
}
</style>

<div class="projects-strip">
    <div class="strip-grid">
        {% for proj in strip_matched %}
        {% set hero = proj.data.blocks[0] %}
        {% set locatie = '' %}
        {% set an = '' %}
        {% for f in hero.tech_fields %}
            {% if f.label == 'Locație' %}{% set locatie = f.value %}{% endif %}
            {% if f.label == 'An proiect' %}{% set an = f.value %}{% endif %}
        {% endfor %}
        <a href="{{ proj.url }}" class="strip-card">
            <div class="strip-img"><img src="{{ hero.image }}" alt="{{ proj.data.title }}" loading="lazy"></div>
            <div class="strip-info">
                <h4>{{ proj.data.title }}</h4>
                <span>{{ locatie }}{% if an %}, {{ an }}{% endif %}</span>
            </div>
        </a>
        {% endfor %}
    </div>
    <div style="text-align: center; margin-top: 2.5rem;">
        <a href="/proiecte/" class="strip-btn">Vezi toate proiectele</a>
    </div>
</div>
{% endif %}
